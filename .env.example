PORT=3001
DB_PATH=./data/vault.db
# off = no embedding model download, ask your vault is off, normal search still work
# EMBEDDINGS=off
JWT_SECRET=change-this-to-a-long-random-string
MASTER_KEY=generate-a-64-char-hex-string-here
LOG_LEVEL=info
JWT_EXPIRES_IN=24h
# Optional — only needed if you want OpenAI for RAG answers instead of Ollama
# OPENAI_API_KEY=sk-...

OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=qwen3-coder:30b
RAG_MODEL=qwen3-coder:30b
