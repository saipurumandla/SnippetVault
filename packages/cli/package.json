{
  "name": "@snippetvault/cli",
  "version": "3.2.0",
  "private": true,
  "description": "sv: save and find SnippetVault snippets from the terminal",
  "type": "module",
  "bin": {
    "sv": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --external:clipboardy --external:commander",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@snippetvault/api-client": "3.2.0",
    "@snippetvault/server": "0.1.0",
    "esbuild": "^0.28.2"
  }
}
