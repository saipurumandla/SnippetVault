{
  "name": "snippetvault",
  "displayName": "SnippetVault",
  "description": "Search your SnippetVault from the editor",
  "version": "3.2.0",
  "private": true,
  "publisher": "snippetvault",
  "repository": {
    "type": "git",
    "url": "https://github.com/saipurumandla/SnippetVault",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snippetvault.setToken",
        "title": "Set access token",
        "category": "SnippetVault"
      },
      {
        "command": "snippetvault.signOut",
        "title": "Sign out",
        "category": "SnippetVault"
      },
      {
        "command": "snippetvault.search",
        "title": "Search vault",
        "category": "SnippetVault"
      },
      {
        "command": "snippetvault.saveSelection",
        "title": "Save selection as snippet",
        "category": "SnippetVault"
      },
      {
        "command": "snippetvault.insert",
        "title": "Insert snippet",
        "category": "SnippetVault"
      }
    ],
    "configuration": {
      "title": "SnippetVault",
      "properties": {
        "snippetvault.serverUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Address of your SnippetVault server."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "snippetvault.saveSelection",
          "when": "editorHasSelection",
          "group": "snippetvault@1"
        },
        {
          "command": "snippetvault.insert",
          "when": "!editorReadonly",
          "group": "snippetvault@2"
        }
      ],
      "commandPalette": [
        {
          "command": "snippetvault.saveSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "snippetvault.insert",
          "when": "editorIsOpen"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build:test": "esbuild test/suite/index.ts test/suite/extension.test.ts --bundle --outdir=out/suite --out-extension:.js=.cjs --external:vscode --external:mocha --format=cjs --platform=node --target=node20",
    "test:vscode": "npm run build && npm run build:test && tsx test/runTest.mts",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@snippetvault/api-client": "3.2.0",
    "@snippetvault/server": "^0.1.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "mocha": "^11.8.0"
  }
}
