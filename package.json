{
  "name": "snippetvault",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm start -w server",
    "build": "npm run build -w client",
    "migrate": "npm run migrate -w server",
    "index": "npm run index -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}
