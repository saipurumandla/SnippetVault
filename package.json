{
  "name": "snippetvault",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm start -w server",
    "build": "npm run build -w @snippetvault/api-client && npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && stylelint \"client/src/**/*.css\" --config client/.stylelintrc.json",
    "test": "npm test --workspaces --if-present",
    "migrate": "npm run migrate -w server",
    "index": "npm run index -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "stylelint": "^17.6.0",
    "typescript-eslint": "^8.58.0"
  }
}
